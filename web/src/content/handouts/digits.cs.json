                [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "U\u00A0úloh s\u00A0číslicemi se vyplatí dívat se na zbytky po dělení\u00A03 nebo\u00A09, protože číslo dává stejný zbytek po dělení\u00A03 nebo\u00A09 právě když je tomu tak pro ciferný součet."
                      }
                    ],
                    "highligted": false
                  }
                ],
                [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Další dobrá kritéria pro číslice jsou pro dělitelnost "
                      },
                      {
                        "type": "math",
                        "text": "2^n",
                        "isDisplay": false
                      },
                      {
                        "type": "text",
                        "text": " (posledních "
