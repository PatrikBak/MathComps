                        "type": "math",
                        "text": "100a+b=99a+(a+b)",
                        "isDisplay": false
                      },
                      {
                        "type": "text",
                        "text": ", takže nutně "
                      },
                      {
                        "type": "math",
                        "text": "11 \\mid a+b",
                        "isDisplay": false
                      },
                      {
                        "type": "text",
                        "text": ". To už není mnoho možností."
                      }
