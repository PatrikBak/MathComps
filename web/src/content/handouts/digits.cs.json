                ],
                [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Uvědomíme si, že "
                      },
                      {
                        "type": "math",
                        "text": "s_s+s_l",
                        "isDisplay": false
                      },
