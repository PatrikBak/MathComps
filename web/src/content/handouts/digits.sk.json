                    {
                      "type": "math",
                      "text": "123456789101112\\dots 100",
                      "isDisplay": false
                    },
                    {
                      "type": "text",
                      "text": " aplikujeme postupne ciferný súčet, až kým nezískame jednociferné číslo. Aké číslo nám zostane?"
