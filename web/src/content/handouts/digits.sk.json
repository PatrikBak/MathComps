                        "type": "text",
                        "text": "."
                      }
                    ],
                    "highligted": false
                  }
                ],
                [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Pri úlohách s\u00A0ciframi sa oplatí pozerať na zvyšky po delení\u00A03 alebo\u00A09, lebo číslo dáva rovnaký zvyšok po delení\u00A03 alebo\u00A09 práve keď je tomu tak pre ciferný súčet."
                      }
                    ],
                    "highligted": false
                  }
                ],
                [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Ďalšie dobré kritéria pre cifry sú pre deliteľnosť "
                      },
                      {
                        "type": "math",
                        "text": "2^n",
                        "isDisplay": false
                      },
                      {
                        "type": "text",
                        "text": " (posledných "
                      },
                      {
                        "type": "math",
                        "text": "n",
                        "isDisplay": false
                      },
                      {
                        "type": "text",
                        "text": " cifier tvorí číslo deliteľné\u00A0"
                      },
                      {
                        "type": "math",
                        "text": "2^n",
                        "isDisplay": false
                      },
                      {
                        "type": "text",
                        "text": ")."
                      }
                    ],
                    "highligted": false
                  }
                ],
                [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "A ešte jedno kritérium: číslo je deliteľné\u00A011 práve keď súčet cifier na párnych miestach dáva rovnaký zvyšok po delení\u00A011 ako súčet cifier na nepárnych miestach."
                      }
                    ],
                    "highligted": false
                  }
                ]
              ],
              "styleType": "LowerRomanParens"
            }
          ]
        }
