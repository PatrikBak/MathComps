                    "highligted": false
                  }
                ]
              ],
              "solution": []
            },
            {
              "type": "problem",
              "difficulty": 0,
              "body": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Na číslo "
