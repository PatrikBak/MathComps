# These have good default
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The mail used in the contact form and privacy page
NEXT_PUBLIC_CONTACT_EMAIL=<placeholder>

# Environment variable for contact forms
RESEND_API_KEY=<placeholder>

# The configuration secrets for Clerk (auth provider)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<placeholder>
CLERK_SECRET_KEY=<placeholder>
CLERK_WEBHOOK_SECRET=<placeholder>

# The configuration for Cloudflare R2
R2_BUCKET_NAME=<placeholder>
CLOUDFLARE_ACCOUNT_ID=<placeholder>
R2_ACCESS_KEY_ID=<placeholder>           
R2_SECRET_ACCESS_KEY=<placeholder>       
NEXT_PUBLIC_R2_URL=<placeholder>