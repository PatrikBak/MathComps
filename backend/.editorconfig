root = true

# General settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# XML/MSBuild files follow the repo's existing 2-space indentation
[*.{sln,csproj,props,targets,nuspec,config}]
indent_style = space
indent_size = 2

[*.cs]
# Formatting
indent_style = space
indent_size = 4

# Prefer modern C# styles
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_properties = when_on_single_line:warning
csharp_style_expression_bodied_indexers = when_on_single_line:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_utf8_string_literals = true:warning
csharp_style_prefer_top_level_statements = true:warning
csharp_style_prefer_extended_property_pattern = true:warning
csharp_style_prefer_primary_constructors = true:warning
csharp_prefer_system_threading_lock = true:warning
csharp_style_prefer_unbound_generic_type_in_nameof = true:warning

# Qualification and member preferences
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_collection_initializer = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning

# Using directives
csharp_using_directive_placement = outside_namespace:warning

# New line preferences
csharp_new_line_before_open_brace = all

# Naming conventions come in trios cross-referenced by name: a *_symbols group (which declarations it
# matches), a *_style (how they must be named), and a *_rule binding the two at a severity.

# Constants are PascalCase.
dotnet_naming_rule.constant_fields_rule.symbols = constant_fields
dotnet_naming_rule.constant_fields_rule.style = pascal_case_style
dotnet_naming_rule.constant_fields_rule.severity = warning
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Private fields (including static readonly) are _camelCase.
dotnet_naming_rule.private_fields_rule.symbols = private_fields
dotnet_naming_rule.private_fields_rule.style = private_prefix_underscore
dotnet_naming_rule.private_fields_rule.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = !const
dotnet_naming_style.private_prefix_underscore.capitalization = camel_case
dotnet_naming_style.private_prefix_underscore.required_prefix = _

# ReSharper's stricter naming defaults are off — the dotnet_naming rules above are the single source of
# naming enforcement. They'd otherwise double-flag deliberate conventions (_camelCase static readonly,
# SK/CS/EN language codes, structural test names like reply1_1).
resharper_inconsistent_naming_highlighting = none

# Analyzer severity defaults (built-in .NET analyzers): all off, then re-enable whole categories as warnings
dotnet_analyzer_diagnostic.severity = none
dotnet_analyzer_diagnostic.category-Style.severity = warning
dotnet_analyzer_diagnostic.category-Design.severity = warning
dotnet_analyzer_diagnostic.category-Performance.severity = warning
dotnet_analyzer_diagnostic.category-Reliability.severity = warning
dotnet_analyzer_diagnostic.category-Usage.severity = warning
dotnet_analyzer_diagnostic.category-Security.severity = warning

# CA1310 — StringComparison on culture-sensitive string ops; warning (catches the culture-default bug class, e.g. StartsWith)
dotnet_diagnostic.CA1310.severity = warning

# CS1591 — missing XML doc on a public member; warning (public members are documented in this codebase, tests included)
dotnet_diagnostic.CS1591.severity = warning

# CA1848 — prefer LoggerMessage delegates; off (source-gen ceremony, our logging is simple)
dotnet_diagnostic.CA1848.severity = none

# CA1852 — type can be sealed; off (we seal deliberately, not on every internal type)
dotnet_diagnostic.CA1852.severity = none

# IDE0058 — expression value is never used; off (too noisy — builders legitimately discard returns)
dotnet_diagnostic.IDE0058.severity = none

# CA2007 — call ConfigureAwait on awaited tasks; off (this is an app, not a library — no context to capture)
dotnet_diagnostic.CA2007.severity = none

# CA1062 — null-check public method arguments; off (NRT already models nullability; explicit guards everywhere are ceremony)
dotnet_diagnostic.CA1062.severity = none

# IDE0011 — add braces around single statements; off (we allow brace-less bodies)
dotnet_diagnostic.IDE0011.severity = none

# SYSLIB1045 — convert regex to [GeneratedRegex]; off (source-gen ceremony for our few regexes)
dotnet_diagnostic.SYSLIB1045.severity = none

# CA1859 — use concrete types for performance; off (micro-optimization — we return interfaces for clarity)
dotnet_diagnostic.CA1859.severity = none

# CA1307 — StringComparison for clarity; off (the correctness cases are covered by CA1310; the rest is noise)
dotnet_diagnostic.CA1307.severity = none

# CA2201 — don't throw reserved exception types; off (CLI tools intentionally throw bare Exception for fatal errors)
dotnet_diagnostic.CA2201.severity = none

# IDE0061 — use block body for local functions; off (we allow expression-bodied local functions)
dotnet_diagnostic.IDE0061.severity = none

# IDE0072 — list every enum case explicitly instead of a default arm; off (our switches use intentional _ => defaults)
dotnet_diagnostic.IDE0072.severity = none

# CA1305 — specify IFormatProvider on format/parse; off (pervasive, rarely a real bug for our invariant data)
dotnet_diagnostic.CA1305.severity = none

# CA1308 — normalize strings to uppercase; off (we use ToLowerInvariant for slugs on purpose)
dotnet_diagnostic.CA1308.severity = none

# CA1861 — avoid constant arrays as arguments; off (perf micro-optimization not worth the noise)
dotnet_diagnostic.CA1861.severity = none

# IDE0320 — make anonymous function static; off (perf micro-optimization)
dotnet_diagnostic.IDE0320.severity = none

# CA1873 — check IsEnabled before evaluating log arguments; off (LoggerMessage ceremony, our logs are simple)
dotnet_diagnostic.CA1873.severity = none

# CA1008 — enums should define a zero value; off (we don't require a None member on every enum)
dotnet_diagnostic.CA1008.severity = none

# CA1515 — make public types internal; off (we decide accessibility ourselves)
dotnet_diagnostic.CA1515.severity = none

# ReSharper (jb inspectcode) suppressions for patterns this codebase uses intentionally.

# ReSharper's unused-symbol inspections assume code constructs every type, but ours are built by frameworks
# it can't trace — Spectre CLI commands + their [CommandOption] settings, xUnit fixtures, System.Text.Json
# DTOs, EF entities, the config binder, parser AST records — so they fire as false positives across the board.
# Genuinely dead code is caught by Roslyn's UnusedType (zero references) and IDE0051 (unused private member).
resharper_class_never_instantiated_global_highlighting = none
resharper_class_never_instantiated_local_highlighting = none
resharper_not_accessed_positional_property_global_highlighting = none
resharper_not_accessed_positional_property_local_highlighting = none
resharper_unused_auto_property_accessor_global_highlighting = none
resharper_unused_auto_property_accessor_local_highlighting = none

# EF entities stay settable for change-tracking; option/CLI-settings classes stay settable for the binder.
resharper_property_can_be_made_init_only_global_highlighting = none
resharper_auto_property_can_be_made_get_only_global_highlighting = none

# 'with' on a record often touches every member; that's the idiomatic copy-and-update, not a smell.
resharper_with_expression_modifies_all_members_highlighting = none

# Sync I/O that has an async overload; off (single-threaded CLI tools and tests don't gain from async).
resharper_method_has_async_overload_highlighting = none

# EF scaffolds migrations with unused usings, block-scoped namespaces, and verbose initializers we don't touch.
[**/Migrations/*.cs]
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0300.severity = none

# Fluent builder extensions return the builder for chaining; ignoring that return is intentional.
# Scoped to *Extensions.cs so the inspection still flags genuinely-ignored returns elsewhere.
[**/*Extensions.cs]
resharper_unused_method_return_value_global_highlighting = none

# Invoked by the EF Core 'dotnet ef' tooling at design time via reflection, never from app code.
[**/MathCompsDbContextFactory.cs]
resharper_unused_type_global_highlighting = none
