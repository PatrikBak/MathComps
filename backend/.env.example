# Base environment configuration
# Copy to .env and configure your values
# For environment-specific overrides, also create .env.prod or .env.staging

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=your-email@example.com

# Strong password for PostgreSQL database
DB_PASSWORD=change-this-to-a-strong-random-password

# Clerk authentication
CLERK_AUTHORITY=https://your-clerk-domain.clerk.accounts.dev
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_WEBHOOK_SECRET=your-clerk-webhook-secret

# AI API (OpenAI-compatible endpoint)
LLM_API_KEY=your-llm-api-key

# Cloudflare R2 — the API reads the AI examiner's problem content from the bucket the handouts CLI publishes to
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
