# Ignore build artifacts and dependencies
**/bin/
**/obj/
**/node_modules/
**/.next/
**/out/

# Ignore git and IDE files
.git/
.gitignore
.gitattributes
**/.vs/
**/.vscode/
**/.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore data and documentation files
data/
docs/
README.md

# Ignore Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
.env
.env.*

# Ignore the gitignored per-environment config. The compose overrides bind-mount it at runtime, so the
# mount stays its only copy and prod secrets stay out of the image layers.
**/appsettings.*.Production.json
**/appsettings.*.Staging.json
**/appsettings.Production.json
**/appsettings.Staging.json

# Ignore test projects
**/tests/

