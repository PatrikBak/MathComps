# Default production overrides (supplements .env)

# Production uses port 5432 (staging uses 5433)
SSH_REMOTE_PORT=5432

# Cloudflare R2 publish keys, the mathcomps-r2-mac-publish token's. They belong in .env.prod, never here: every
# script loading prod's environment exports them, they override the dev keys in user secrets, and the Handouts and
# Bulk Import CLIs write prod with them only when given --publish. Left empty here they would still be exported and
# blank out the dev keys.
# CloudflareR2__AccountId=
# CloudflareR2__PublicBucketName=
# CloudflareR2__PrivateBucketName=
# CloudflareR2__AccessKeyId=
# CloudflareR2__SecretAccessKey=
