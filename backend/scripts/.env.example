# Path to your SSH private key file (PEM format)
SSH_KEY_PATH=path/to/your/ssh/key.pem

# SSH connection string (user@hostname)
SSH_HOST=user@host.example.com

# Remote database hostname (as seen from the SSH server)
SSH_REMOTE_HOST=localhost

# Remote database port (as seen from the SSH server)
SSH_REMOTE_PORT=5432

# Local port where the SSH tunnel listens and where database clients connect
# This is the port you'll use in your connection string (e.g., localhost:6666)
DB_TUNNEL_PORT=6666

# Database host (use 'localhost' when connecting through the tunnel)
DB_HOST=localhost

# Database name
DB_NAME=mathcomps

# Database username
DB_USERNAME=mathcomps

# Database password
DB_PASSWORD=your_database_password
