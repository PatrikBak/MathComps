# Base environment configuration for scripts
# Copy to .env and configure your values
# For environment-specific overrides, also create .env.prod or .env.staging

# SSH host to connect through. Use a host alias from ~/.ssh/config (which supplies the
# user, hostname and key); a bare user@host works too but then SSH must find a key on its own.
SSH_HOST=mathcomps

# Remote database hostname (as seen from the SSH server)
SSH_REMOTE_HOST=localhost

# Remote database port (as seen from the SSH server)
SSH_REMOTE_PORT=5432

# Local port where the SSH tunnel listens
DB_TUNNEL_PORT=6666

# Database name
DB_NAME=mathcomps

# Database username
DB_USERNAME=mathcomps

# Database password
DB_PASSWORD=your_database_password
