{
  "Logging": {
    "LogLevel": {
      // At Information the framework writes lines for every SQL command and HTTP request, so everything outside our own
      // code starts at Warning
      "Default": "Warning",
      "MathComps": "Information"
    },
    "Console": {
      // Without a formatter name the console logger falls back to its old options and ignores FormatterOptions
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "HH:mm:ss "
      }
    }
  }
}
