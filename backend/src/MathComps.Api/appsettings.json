{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Warning"
    },
    // Keep these categories out of Sentry. EF logs one line per failed
    // command, where GlobalExceptionHandler reports the same fault with the request attached. A health
    // check logs one every 30 seconds while the database is down, which the uptime monitor catches.
    // The mail sender standing in where no Resend key is set logs each whole mail, recipient's address
    // included, which stays out of Sentry's breadcrumbs.
    "Sentry": {
      "LogLevel": {
        "Microsoft.EntityFrameworkCore": "None",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "None",
        "MathComps.Infrastructure.Services.Mail.LoggingMailSender": "None"
      }
    }
  },
  "Sentry": {
    // Where exceptions go. Empty is the SDK's own disabled value, and a missing one throws on startup.
    "Dsn": ""
  },
  "Cors": {
    "Origins": ["http://localhost:3000"]
  },
  "HostedCompetitions": {
    "NoteGraceMinutes": 30,
    "MaxNoteChars": 2000
  },
  "Pagination": {
    "DefaultPageSize": 25,
    "MaxPageSize": 50
  },
  "Similarity": {
    // Right now, similar problems are turned off for they have not been
    // tested tweaked properly yet and I have a feeling they work a bit randomly.
    // The goal is to release them with a UI where users can tweak the weights by
    // themselves. Ideally also paste a problem and seek similar ones to the one
    // they pasted (though this might be expensive for we'd either need an
    // embdeeing service somewhere -- the one in the codebase would not run
    // on any cheap server...
    "MaxSimilarProblems": 0,
    "MinSimilarityScore": 0.85
  },
  "Localization": {
    "DefaultLocale": "EN"
  },
  "Examiner": {
    // The engine's per-step models live in the shared appsettings.examiner.json; this host-only flag
    // flips to true (in appsettings.Development.json or user secrets) to run the zero-cost fake examiner
    // and drive the whole flow without spending tokens.
    "UseFake": false
  },
  "DefenseLimits": {
    "MaxCandidateChars": 10000,
    "MaxFeedbackCommentChars": 2000,
    "MaxMessagesPerDefense": 50,
    "DailySpendCeilingPerUser": 10.0
  },
  "Site": {
    // Where every link out to the site points, and the address mail comes from and people write to
    "Url": "https://mathcomps.fun",
    "ContactAddress": "contact@mathcomps.fun"
  },
  "MailOutbox": {
    // How often the API looks for queued mail that is due
    "PollInterval": "00:01:00",
    // How long a failed mail waits before each next attempt, given up after the last
    "RetryDelays": ["00:01:00", "00:05:00", "00:30:00", "02:00:00", "12:00:00"]
  },
  "GradeMessageMail": {
    // How often the API looks for people whose news of grade conversations has gone quiet
    "PollInterval": "00:01:00",
    // How long nothing new has to arrive for somebody before their mail is written
    "QuietPeriod": "00:10:00",
    // The least time between two mails to one person, whatever arrives meanwhile waiting for the next one
    "MinimumGap": "01:00:00"
  },
  "DefenseContent": {
    // Handout content is published straight to object storage, so this is how long an edited problem can
    // take to reach a new defense. Revalidating costs one round trip in front of a model call.
    "CacheSeconds": 60
  }
}
